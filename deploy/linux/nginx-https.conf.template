server {
    listen 443 ssl;
    server_name __SERVER_IP__;

    ssl_certificate /etc/letsencrypt/live/points-home/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/points-home/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:PointsHomeTLS:1m;
    ssl_session_timeout 1h;

    client_max_body_size 10m;
    client_body_timeout 30s;
    server_tokens off;

    location /api/v1/ {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Replace incoming headers so clients cannot spoof IP-based limits.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        # Includes uploading images from this 3 Mbps server to the AI provider.
        proxy_read_timeout 180s;
        proxy_send_timeout 30s;
        proxy_buffering off;
        add_header Cache-Control "no-store" always;
    }

    location / {
        return 404;
    }
}
